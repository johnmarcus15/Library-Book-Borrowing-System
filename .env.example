# ======================================================================
# Environment Variables for Vercel Deployment & Local Development
# ======================================================================

# 1. MongoDB Connection URI (Required on Vercel)
# Create a free MongoDB Atlas cluster at https://cloud.mongodb.com
# Replace <username>, <password>, and cluster domain with your own credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/library?retryWrites=true&w=majority

# 2. JWT Secret for Auth Token Signing (Required on Vercel)
# Use a random 32+ character string
JWT_SECRET=f983a54b830d9396e95c10ad8bc9d2e4682051db5e3ea1e0b503ab4e9185a73d578b8cf441e33dc781878bcae9fa1e2a

# 3. Environment
NODE_ENV=production

# 4. Central Library Rules (Optional - Defaults apply if omitted)
LOAN_DAYS=14
MAX_ACTIVE_BORROWINGS=5
FINE_PER_DAY=5

# 5. Initial Admin Credentials (Used by seed script / /api/seed)
ADMIN_NAME=Head Librarian
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminStrongPass#2026
ADMIN_STUDENT_ID=ADMIN001
