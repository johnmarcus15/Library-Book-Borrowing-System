PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/library
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
# Set true only on Atlas or a local replica set
USE_TRANSACTIONS=false
LOAN_DAYS=14
MAX_ACTIVE_BORROWINGS=5
FINE_PER_DAY=5
# createAdmin script (password 12+ chars)
ADMIN_NAME=Head Librarian
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_STUDENT_ID=
# Optional override of the dev-only seed member password
# SEED_PASSWORD=

# Tests use a SEPARATE database. The name must contain 'test' or the suite refuses to run (it wipes collections).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/library_test
