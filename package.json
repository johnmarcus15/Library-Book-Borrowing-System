{
  "name": "library-book-borrowing-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev": "node -e \"console.log('Use start.bat or run server and client in separate terminals')\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/src/server.js",
    "seed": "node server/scripts/seed.js",
    "admin:create": "node server/scripts/createAdmin.js",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2"
  }
}
